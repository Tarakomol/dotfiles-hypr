{
    // ------------------------------------------------------------------
    // Позиционирование: сплошная полоса на всю ширину, без отступов
    // ------------------------------------------------------------------
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    // ------------------------------------------------------------------
    // Раскладка модулей: слева воркспейсы, по центру часы, справа статус
    // ------------------------------------------------------------------
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "tray"
    ],

    // ------------------------------------------------------------------
    // Воркспейсы Hyprland: только текстовые теги, без иконок
    // ------------------------------------------------------------------
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true
    },

    // ------------------------------------------------------------------
    // Часы и дата: один текстовый блок в квадратных скобках
    // ------------------------------------------------------------------
    "clock": {
        "format": "[ {:%a %d.%m  %H:%M} ]",
        "format-alt": "[ {:%H:%M:%S} ]",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // ------------------------------------------------------------------
    // Процессор: текстовый индикатор
    // ------------------------------------------------------------------
    "cpu": {
        "interval": 1,
        "format": "[ CPU: {usage}% ]"
    },

    // ------------------------------------------------------------------
    // Память: текстовый индикатор
    // ------------------------------------------------------------------
    "memory": {
        "interval": 1,
        "format": "[ RAM: {percentage}% ]"
    },

    // ------------------------------------------------------------------
    // Звук: текстовый индикатор, без Nerd Font иконок
    // ------------------------------------------------------------------
    "pulseaudio": {
        "format": "[ VOL: {volume}% ]",
        "format-muted": "[ VOL: MUTE ]",
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    // ------------------------------------------------------------------
    // Системный трей
    // ------------------------------------------------------------------
    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}
