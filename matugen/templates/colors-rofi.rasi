* {
    bg-col: {{colors.surface.default.hex}};
    bg-col-light: {{colors.surface_container.default.hex}};
    border-col: {{colors.outline.default.hex}};
    selected-col: {{colors.primary_container.default.hex}};
    accent: {{colors.primary.default.hex}};
    fg-col: {{colors.on_surface.default.hex}};
    fg-col2: {{colors.on_surface_variant.default.hex}};
    bg-col-a: #{{colors.surface.default.hex_stripped}}e6;
    bg-col-light-a: #{{colors.surface_container.default.hex_stripped}}b3;
    bg-col-card-a: #{{colors.surface_container.default.hex_stripped}}80;
    selected-col-a: #{{colors.primary_container.default.hex_stripped}}59;
    border-col-a: #{{colors.outline.default.hex_stripped}}66;
}
