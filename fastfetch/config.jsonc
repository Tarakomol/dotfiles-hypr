
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/mge/Изображения/Screenshots/Увы.jpg",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "yellow",
      "title": "yellow"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel"
    },
    {
      "type": "wm",
      "key": "󰍹 WM"
    },
    {
      "type": "uptime",
      "key": "󰔐 Uptime"
    },
    {
      "type": "shell",
      "key": "󱆃 Shell"
    },
    {
      "type": "theme",
      "key": "󰏘 Theme"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
